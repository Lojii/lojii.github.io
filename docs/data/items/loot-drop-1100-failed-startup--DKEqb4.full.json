<div class=\"modal-overlay\" id=\"modal-overlay\">\n        <div class=\"modal\" id=\"modal\">\n          <button class=\"modal-close\" id=\"modal-close\">✕</button>\n          <div class=\"modal-content\" id=\"modal-content\">\n            <!-- Modal content will be injected here -->\n          </div>\n        </div>\n      </div>\n\n      <!-- Floating Bucket Button -->\n      <button class=\"floating-bucket\" id=\"open-request-bucket\" title=\"Request Loot or Features\">\n        <span class=\"bucket-icon\">🪣</span>\n        <span class=\"bucket-text\">ADD A CORPSE <i>(or feature request)</i></span>\n      </button>\n\n      <!-- Back to Top Button -->\n      <button class=\"back-to-top\" id=\"back-to-top\" title=\"Back to Top\">\n        <span class=\"back-to-top-icon\">↑</span>\n      </button>\n\n      <!-- Request Modal -->\n      <div class=\"modal-overlay\" id=\"request-modal-overlay\">\n        <div class=\"modal request-modal\" id=\"request-modal\">\n          <button class=\"modal-close\" id=\"close-request-bucket\">✕</button>\n          <div class=\"request-modal-header\">\n            <h2>💀 REQUEST NEW LOOT</h2>\n            <p>Found a dead startup we missed? Want a new feature? Dump it into the bucket.</p>\n          </div>\n          <form id=\"request-form\" class=\"request-form\">\n            <div class=\"form-group\">\n              <label for=\"request-type\">TYPE OF DROP</label>\n              <select id=\"request-type\" required=\"\">\n                <option value=\"data\">Missing Startup (Data)</option>\n                <option value=\"feature\">New Feature</option>\n                <option value=\"report\">Data Correction</option>\n                <option value=\"other\">Other</option>\n              </select>\n            </div>\n            <div class=\"form-group\">\n              <label for=\"request-content\">THE GOODS</label>\n              <textarea id=\"request-content\" placeholder=\"Tell us the story... URLs, names, or feature ideas.\" required=\"\"></textarea>\n            </div>\n            <div class=\"form-group\">\n              <label for=\"request-email\">YOUR EMAIL (OPTIONAL)</label>\n              <input type=\"email\" id=\"request-email\" placeholder=\"For updates on your loot\">\n            </div>\n            <button type=\"submit\" class=\"submit-request-btn\">BURY THE GOODS</button>\n          </form>\n          <div id=\"request-status\" class=\"request-status\"></div>\n        </div>\n      </div>\n\n    </div> <!-- /.main-content-area -->\n  </div> <!-- /.main-layout -->\n\n  <div style=\"max-width:720px;margin:24px auto 40px;padding:0 20px;\">\n    <p style=\"font-family:'Space Grotesk',sans-serif;font-size:11px;line-height:1.7;color:#999;text-align:center;\">\n      Disclaimer: This content is an AI-assisted summary and analysis derived from publicly available sources only\n      (news, founder statements, funding data, etc.). It represents patterns, opinions, and interpretations for\n      educational purposes—not verified facts, accusations, or professional advice. AI can contain errors or\n      ‘hallucinations’; all content is human-reviewed but provided ‘as is’ with no warranties of\n      accuracy, completeness, or reliability. We disclaim all liability for reliance on or use of this information. If\n      you believe any information is inaccurate or wish to request a correction, please click the <strong style=\"color:#666;\">Disclaimer</strong> button to submit a request.\n    </p>\n  </div>\n  \n\n\n</body></html>"
